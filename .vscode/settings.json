{
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    ".build": true,
    "**/.swiftpm": true,
    "dist": true,
    "**/DerivedData": true,
    "coverage.lcov": true,
    "*.lcov": true,
    ".coverage": true,
    "coverage": true,
    "sbom-deps.json": true,
    ".scannerwork": true,
    ".sonarcloud": true,
    ".task": true,
    "coverage*.txt": true,
    "build": true,
    "coverage*.xml": true,
    "coverage*.md": true,
    "coverage*.profdata": true,
    "test_output.log": true,
    "**/*.tmp": true
  },
  "search.exclude": {
    "**/node_modules": true,
    ".build/**": true,
    ".swiftpm/**": true,
    "dist/**": true,
    "**/DerivedData/**": true,
    "coverage*": true,
    ".coverage/**": true,
    ".scannerwork/**": true,
    ".sonarcloud/**": true,
    "MagSafeGuard.xcodeproj/**": true
  },
  "editor.formatOnSave": true,
  "editor.rulers": [80, 120],
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    }
  },
  "[swift]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "yaml.schemas": {
    "https://json.schemastore.org/github-workflow.json": [
      ".github/workflows/*.yml",
      ".github/workflows/*.yaml"
    ]
  },
  "yaml.validate": true,
  "github-actions.workflows.pinned.refresh.enabled": false,
  "problems.showCurrentInStatus": false,
  "github-actions.disable-validation": true,
  "files.associations": {
    "*.mdc": "markdown"
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/*.tmp": true,
    ".build/**": true,
    ".swiftpm/**": true,
    "dist/**": true,
    "coverage*": true,
    ".coverage/**": true,
    ".scannerwork/**": true,
    ".sonarcloud/**": true
  }
}
